# Clave de la API de Claude (Anthropic). Sin ella, Traza usa su motor local de catálogo.
ANTHROPIC_API_KEY=
# Modelo opcional (por defecto claude-opus-5-5)
TRAZA_MODEL=claude-opus-5-5
# Base de datos (docker compose up -d)
DATABASE_URL=mysql://traza:traza_dev@127.0.0.1:3307/traza
# Clave para firmar las cookies de sesión
SESSION_SECRET=
